{
  "name": "fearch-mcp",
  "version": "4.1.0",
  "description": "Respectful web search and page reading for AI agents: an MCP server and CLI that identify themselves honestly, honour robots.txt, and treat a refusal as final.",
  "license": "MIT",
  "homepage": "https://github.com/funkyfunc/fearch#bot-info",
  "type": "module",
  "bin": {
    "fearch": "./dist/index.js"
  },
  "files": [
    "dist",
    "extension/background.js",
    "extension/manifest.json",
    "extension/status.html",
    "extension/status.js"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
    "prepack": "npm run build && node -e \"fs.copyFileSync('../../README.md','README.md');fs.copyFileSync('../../LICENSE','LICENSE')\"",
    "start": "node dist/index.js",
    "dev": "tsx src/cli.ts",
    "build:dev": "node -e \"fs.rmSync('dist-dev',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "linkedom": "^0.18.13",
    "playwright": "^1.62.1",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "undici": "^8.10.0",
    "unpdf": "^1.8.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funkyfunc/fearch.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/funkyfunc/fearch/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "web-search",
    "web-fetch",
    "search",
    "fetch",
    "agent",
    "robots-txt",
    "human-in-the-loop",
    "duckduckgo",
    "google",
    "cli",
    "ai-agent",
    "llm",
    "browser",
    "claude",
    "model-context-protocol"
  ]
}
