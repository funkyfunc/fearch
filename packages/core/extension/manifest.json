{
  "manifest_version": 3,
  "name": "fearch bridge",
  "version": "2.3.0",
  "description": "Lets the fearch search/fetch tool open pages in your own Chrome — read-only, no automation flags, no debugger. Nothing runs unless fearch is running on this machine.",
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "incognito": "spanning",
  "options_page": "status.html",
  "action": { "default_title": "fearch bridge", "default_popup": "status.html" }
}
